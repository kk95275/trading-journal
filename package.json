{
  "name": "trading-journal",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first trading journal + bar-replay backtester",
  "author": {
    "name": "Karim Khalil",
    "email": "karimtkhalil2004@gmail.com"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "convert-data": "node scripts/convert-data.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --publish never",
    "release": "npm run build && npm run electron:compile && electron-builder --publish always"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.karim.tradingjournal",
    "productName": "Trading Journal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/data/**",
      "dist-electron/**/*",
      "scripts/lib/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/lib/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "kk95275",
      "repo": "trading-journal"
    }
  }
}
